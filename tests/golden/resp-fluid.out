/* Text styles */
.headings-heading-2xl {
  font-family: var(--ds-font-family-heading), sans-serif;
  font-weight: var(--ds-font-weight-heavy);
  font-size: clamp(3.2rem, 2.0732rem + 3.0047vw, 6.4rem);
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.headings-heading-lg {
  font-family: var(--ds-font-family-heading), sans-serif;
  font-weight: var(--ds-font-weight-heavy);
  font-size: clamp(2.4rem, 1.8366rem + 1.5023vw, 4rem);
  line-height: 1.1;
}

.body-body-sm {
  font-family: var(--ds-font-family-text), sans-serif;
  font-weight: var(--ds-font-weight-regular);
  font-size: var(--ds-font-size-text-sm);
  line-height: 1.6;
}

.info-callout-md {
  font-family: "Source Serif 4", serif;
  font-weight: 400;
  font-style: italic;
  font-size: 2.8rem;
  line-height: 1.5;
  text-transform: uppercase;
}

.code-inline {
  font-family: var(--ds-font-family-mono), monospace;
  font-weight: 500;
  font-size: 1.4rem;
  line-height: 18px;
  letter-spacing: 1px;
  text-decoration: underline;
}
